# OAuth callback origin. Use https://your-domain.example in production.
OMNISYNC_AUTH_BASE_URL=http://localhost:3000

# Generate a private random value of at least 32 characters. Keep it server-side.
OMNISYNC_AUTH_SECRET=

# X (OAuth 2.0)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Instagram Login
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# LinkedIn Sign In with OpenID Connect
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Threads API
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

# Google OAuth client for YouTube channel lookup
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok Login Kit
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
